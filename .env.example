# Copy to .env (or .env.local / .env.production) and fill in real values.
# This file is the ONLY tracked env file — it must contain NO real secrets.

SECRET_KEY=change-me-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# Must include ?charset=utf8mb4 to avoid Korean/CJK corruption
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dbname?charset=utf8mb4


# push notification
# Shared secret with LMS. Caller sends it as the X-API-Key header.
# Leave empty to disable API-key auth (admin JWT still works).
LMS_API_KEY=

# FCM service-account JSON key (Firebase Console > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성).
# NEVER commit the key file itself (covered by the *.json gitignore rule).
# Convention: place it at the project root as firebase-serviceAccountKey.json and use that
# relative path (works because uvicorn/systemd run from the project root). Absolute paths also fine.
# Empty = fall back to GOOGLE_APPLICATION_CREDENTIALS; if neither is set, FCM sends fail
# (server still boots and everything else keeps working).
FIREBASE_CREDENTIALS_PATH=firebase-serviceAccountKey.json


# Azure Speech (app Recording → text). Same subscription the LMS recording site uses.
# The key never leaves the server: the app only receives 10-minute tokens from GET /recordings/azure-token.
# Empty = transcription disabled (server boots, recording on the phone still works).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2

# --- Check build --- (GET /app/version-check; same names as the student API)
# Version/build currently live in each store. App version below it → forced update;
# same version with a lower build → store hint. Empty VERSION = no check for that platform; BUILD 0 = no build compare.
APP_ANDROID_VERSION=1.4.0
APP_ANDROID_BUILD=21
APP_IOS_VERSION=1.4.0
APP_IOS_BUILD=17
